# Copy this file to .env and replace the placeholders. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/mediguide

# Required in production; use at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Public frontend origin used in password-reset and appointment-reminder links.
APP_URL=http://localhost:5173

# Optional: only needed for AI chat and prescription-extraction features.
GROQ_API_KEY=

# Optional: prefer Google Places hospital listings/photos. Without this key,
# the hospital directory uses OpenStreetMap with MongoDB caching.
GOOGLE_PLACES_API_KEY=

# Recommended for public deployments: identify the project and a contact so
# OpenStreetMap/Nominatim operators can reach you if needed.
HOSPITAL_DIRECTORY_USER_AGENT=

# Optional: appointment confirmations, password resets, and appointment reminders.
# RESEND_API_KEY and MAIL_FROM are required for all email delivery. Reset/reminder
# links use APP_URL, falling back to CLIENT_ORIGIN/CLIENT_URL when APP_URL is not set.
# Keep real values only in your local/deployment environment.
RESEND_API_KEY=
# Use a sender on YOUR verified Resend domain, for example:
# MAIL_FROM="MediGuide <appointments@your-verified-domain.com>"
MAIL_FROM=
