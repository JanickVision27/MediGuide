# Copy this file to .env and replace the placeholders. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/mediguide

# Required in production; use at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional: only needed for AI chat and prescription-extraction features.
GROQ_API_KEY=
