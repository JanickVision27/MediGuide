# Server environment variables.
# Copy this file to `.env` in the repository root (never commit the real file).
# On Render these are configured in the service dashboard instead.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (Atlas or local). No spaces, no surrounding quotes
# unless they are part of the value.
MONGODB_URI=mongodb://127.0.0.1:27017/mediguide

# Session signing secret. Required in production, minimum 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Set to "production" on Render/Hosted environments.
NODE_ENV=development

# --- Server ----------------------------------------------------------------
# Render injects PORT automatically; 5000 is the local default.
PORT=5000

# Comma-separated browser origins allowed to call the API.
# The deployed Vercel frontend (https://medi-guide-care.vercel.app) and any
# https://*.vercel.app preview URL are allowed by default, so this is additive.
CLIENT_ORIGIN=http://localhost:5173

# Optional: extra wildcard origins, comma separated. Example:
# CLIENT_ORIGIN_PATTERNS=https://*.example.com
# CLIENT_ORIGIN_PATTERNS=

# Number of reverse-proxy hops in front of the API (Render/Vercel = 1).
# TRUST_PROXY=1

# Cookie policy for the session cookie:
#   unset / lax  -> same-origin deployments (recommended: Vercel proxies /api)
#   none         -> the browser calls the API on a different hostname
# SESSION_COOKIE_SAME_SITE=lax

# --- Frontend links and optional features ----------------------------------
# Public frontend origin used in password-reset and reminder e-mails.
APP_URL=http://localhost:5173

# Resend e-mail (optional). MAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=re_your_actual_key
# MAIL_FROM="MediGuide <appointments@your-verified-domain.com>"

# Groq AI (optional) - medicine lookups, chat, prescription extraction.
# GROQ_API=your-groq-api-key

# Google Places (optional) - better hospital listings/photos.
# GOOGLE_PLACES_API_KEY=your-google-places-key

# Identifies the app to OpenStreetMap/Nominatim. Set for public deployments.
# HOSPITAL_DIRECTORY_USER_AGENT="MediGuide/1.0 (https://your-site.example)"
