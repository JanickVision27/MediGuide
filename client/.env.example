# Frontend environment variables (Vite).
# Copy to `.env` for local experiments only - on Vercel set these in the dashboard.
# Values are inlined at BUILD time, so changing one requires a redeploy.

# Leave this unset for the recommended setup: the browser calls the relative
# "/api" path and the proxy in vercel.json (or the Vite dev server) forwards it
# to the API. That keeps requests same-origin, so no CORS preflight and no
# third-party session cookie.
#
# Only set it when the API is exposed on a different public hostname. It must use
# https:// and the /api prefix (a bare origin also works - "/api" is appended).
# VITE_API_URL=https://mediguide-0a1e.onrender.com/api
